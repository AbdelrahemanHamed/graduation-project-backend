PORT=3000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grad_project_drive?schema=public"

# JWT configuration
JWT_SECRET="super-secret-jwt-graduation-key-change-in-production"
JWT_EXPIRES_IN="7d"

# File Storage path (Relative to project root or absolute)
UPLOAD_DIR="uploads"

# Storage quota default: 5GB (in bytes)
DEFAULT_STORAGE_LIMIT_BYTES=5368709120
